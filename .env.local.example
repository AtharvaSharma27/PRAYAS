# GistCheck · Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to git (it's already in .gitignore).

# ─── LLM Backend ──────────────────────────────────────────────────────────────
# Gemini API key — REQUIRED for real evaluation (hybrid mode).
# Get yours free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended fast model (supports structured JSON output):
GEMINI_MODEL=gemini-flash-lite-latest

# ─── Mode Switch ───────────────────────────────────────────────────────────────
# false → use real Next.js API routes + Gemini LLM
# true  → use the built-in mock backend
NEXT_PUBLIC_USE_MOCK=false

# ─── External API URL (optional) ──────────────────────────────────────────────
# Leave empty to use Next.js local API routes
NEXT_PUBLIC_API_BASE_URL=
